00+00:00\",\"dateModified\":\"2024-10-21T08:56:02+00:00\",\"author\":{\"@type\":\"Person\",\"name\":\"Nhựt Liên\",\"url\":\"https://fptshop.com.vn/tin-tuc/tac-gia/nhut-lien-7EB26B2A\",\"image\":\"https://cdn2.fptshop.com.vn/small/l_f5095523f4.jpg\",\"description\":\"Mặc dù tốt nghiệp ngành Tài chính tại trường đại học Ngân Hàng TP.HCM nhưng mình đã “bén duyên” với lĩnh vực content từ năm 2019. Cho đến thời điểm hiện tại, mình luôn theo đuổi niềm đam mê viết lách qua các chủ đề công nghệ, thủ thuật, đánh giá và game tại FPT Shop. Kho bài viết của mình đang dần"])</script><script>self.__next_f.push([1," lớn hơn với nhiều thông tin hữu ích hơn, hi vọng nó sẽ mang đến những giá trị thiết thực cho cuộc sống của bạn!\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"FPT Shop\",\"url\":\"https://fptshop.com.vn/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://fptshop.com.vn/img/logo.svg\"}},\"@type\":\"Article\"}"])</script><script>self.__next_f.push([1,"8:[[\"$\",\"$L28\",null,{\"base\":{\"screen_location\":\"article_detail_basic\",\"page_context\":154450},\"children\":[[\"$\",\"$L47\",null,{\"children\":[[\"$\",\"section\",null,{\"id\":\"articleDetail-breadcrumb\",\"style\":{\"background\":\"linear-gradient(180deg, rgba(247, 245, 240, 0.9976) 0%, #FFFFFF 100%)\"},\"children\":[\"$\",\"div\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"container mb:py-2 pc:py-3\",\"children\":[\"$\",\"$14\",null,{\"fallback\":null,\"children\":[[\"$\",\"$L15\",null,{\"moduleIds\":[\"app/tin-tuc/[cate]/[slug]/page.tsx -\u003e @estore/ui/Breadcrumb\"]}],[\"$\",\"$L48\",null,{\"routes\":[{\"name\":\"Tin tức\",\"slug\":\"/tin-tuc\"},{\"name\":\"Thủ thuật\",\"slug\":\"/tin-tuc/thu-thuat\"},{\"name\":\"Bài viết\",\"slug\":\"/100+ Mẫu avatar trắng đẹp, hiện đại, theo xu hướng hình đại diện đơn giản mà độc đáo\"}]}]]}]}]}]}],[\"$\",\"article\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"section\",null,{\"children\":[\"$\",\"di